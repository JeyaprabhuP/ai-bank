# Copy this file to .env to configure the backend.
# Everything works out of the box in MOCK mode (no keys required).

# LLM_BACKEND: mock | openai | ollama | auto (default: auto -> uses OpenAI if OPENAI_API_KEY is set, else mock)
LLM_BACKEND=openai

# Only needed if LLM_BACKEND=openai
OPENAI_API_KEY=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
LLM_MODEL=gpt-4o-mini

# Only needed if LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
